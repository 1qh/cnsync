{
  "name": "a",
  "private": true,
  "workspaces": [
    "apps/*",
    "readonly/*"
  ],
  "scripts": {
    "check": "lintmax check",
    "clean": "sh clean.sh",
    "fix": "lintmax fix && turbo check:imports build",
    "prepare": "bunx simple-git-hooks",
    "sync": "bun sync.ts",
    "test:e2e": "turbo test:e2e",
    "verify": "bun clean && bun i --ignore-scripts && bunx simple-git-hooks && bun run fix && bun run check"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run verify && git add -u"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@xyflow/react": "latest",
    "lintmax": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest",
    "simple-git-hooks": "latest",
    "tailwindcss": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.11"
}
