{
  "name": "a",
  "private": true,
  "workspaces": [
    "apps/*",
    "readonly/*"
  ],
  "scripts": {
    "check": "lintmax check",
    "clean": "rm -rf .cache .turbo apps/web/.next apps/web/node_modules readonly/ui/node_modules",
    "fix": "lintmax fix && turbo check:imports build",
    "sync": "bun sync.ts",
    "test:e2e": "turbo test:e2e"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@xyflow/react": "latest",
    "bun-git-hooks": "latest",
    "lintmax": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "playwright": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.11",
  "git-hooks": {
    "pre-commit": "bun clean && bun i && bun fix"
  }
}
