{
  "private": true,
  "workspaces": [
    "apps/*",
    "readonly/*"
  ],
  "scripts": {
    "action": "sh up.sh",
    "build": "turbo build --output-logs=errors-only",
    "check": "lintmax check",
    "clean": "sh clean.sh",
    "fix": "lintmax fix && turbo check:imports build --output-logs=errors-only",
    "postinstall": "sherif",
    "prepare": "bunx simple-git-hooks",
    "sync": "bun sync.ts",
    "test:e2e": "turbo test:e2e --output-logs=errors-only",
    "test:e2e": "turbo test:e2e --output-logs=errors-only"
  },
  "simple-git-hooks": {
    "pre-commit": "sh up.sh && git add -u"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@xyflow/react": "latest",
    "lintmax": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "playwright": "latest",
    "sherif": "latest",
    "simple-git-hooks": "latest",
    "tsdown": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "esbuild",
    "lintmax",
    "simple-git-hooks"
  ]
}
