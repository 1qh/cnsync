{
  "name": "a",
  "private": true,
  "workspaces": [
    "apps/*",
    "readonly/*"
  ],
  "scripts": {
    "check": "lintmax check",
    "check:imports": "bun check-imports.ts",
    "clean": "rm -rf .cache node_modules apps/web/.next apps/web/node_modules readonly/ui/node_modules",
    "fix": "lintmax fix && bun check:imports && turbo build",
    "sync": "bun sync.ts",
    "test:e2e": "turbo build && bun test-page.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@xyflow/react": "latest",
    "lintmax": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "playwright": "^1.59.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.11"
}
